# Copy to /opt/bridge2ukraine/.env on the server and `chmod 600 .env`. Never commit it.

# Image tag to run. Deploy or roll back by changing this (deploy.sh does it for you).
APP_VERSION=0.1.0
# IMAGE=ghcr.io/<owner>/bridge2ukraine-cms   # only if the image lives elsewhere

# Port on 127.0.0.1 that Plesk's nginx proxies to.
APP_PORT=3000

# Generate each with: openssl rand -hex 32
PAYLOAD_SECRET=
POSTGRES_PASSWORD=
