# Local development. Copy to .env and adjust. Never commit .env.
# Matches compose.dev.yml (Postgres on localhost:5433).
DATABASE_URL=postgresql://payload:payload@localhost:5433/bridge2ukraine
# Used only by `pnpm test`. The tests wipe this database.
TEST_DATABASE_URL=postgresql://payload:payload@localhost:5433/bridge2ukraine_test
# Any long random string locally; generate with: openssl rand -hex 32
PAYLOAD_SECRET=change-me-local-dev-secret
